{
  "slug": "og-image",
  "name": "Open Graph Image",
  "description": "1200×630 link preview for blog posts, docs and landing pages (og:image / twitter:card).",
  "category": "marketing",
  "definition": {
    "width": 1200,
    "height": 630,
    "params": {
      "title": { "type": "string", "label": "Title", "default": "Generate beautiful images from JSON templates", "maxLength": 120, "multiline": true },
      "description": { "type": "string", "label": "Description", "default": "One API call, no headless browser. PNG, JPEG or SVG in milliseconds.", "maxLength": 200, "multiline": true },
      "siteName": { "type": "string", "label": "Site name", "default": "html-to-img", "maxLength": 40 },
      "url": { "type": "string", "label": "URL", "default": "img.refandi.my.id", "maxLength": 60 },
      "tag": { "type": "string", "label": "Tag", "default": "Developer tools", "maxLength": 30 },
      "logo": { "type": "image", "label": "Logo", "default": "" },
      "accentColor": { "type": "color", "label": "Accent color", "default": "#8b5cf6" },
      "theme": { "type": "enum", "label": "Theme", "options": ["dark", "light"], "default": "dark" }
    },
    "root": {
      "type": "box",
      "style": {
        "position": "relative",
        "flexDirection": "column",
        "justifyContent": "space-between",
        "width": "100%",
        "height": "100%",
        "padding": "64px 72px",
        "fontFamily": "Figtree",
        "backgroundColor": { "$switch": "theme", "cases": { "dark": "#09090b", "light": "#fafafa" } },
        "color": { "$switch": "theme", "cases": { "dark": "#fafafa", "light": "#09090b" } },
        "overflow": "hidden"
      },
      "children": [
        {
          "type": "box",
          "style": {
            "position": "absolute",
            "top": -260,
            "right": -180,
            "width": 720,
            "height": 720,
            "borderRadius": 360,
            "backgroundColor": "{{accentColor}}",
            "opacity": { "$switch": "theme", "cases": { "dark": 0.35, "light": 0.18 } }
          }
        },
        {
          "type": "box",
          "style": {
            "position": "absolute",
            "top": 0,
            "left": 0,
            "width": "100%",
            "height": "100%",
            "backgroundImage": {
              "$switch": "theme",
              "cases": {
                "dark": "linear-gradient(115deg, #09090b 45%, rgba(9,9,11,0.55) 100%)",
                "light": "linear-gradient(115deg, #fafafa 45%, rgba(250,250,250,0.55) 100%)"
              }
            }
          }
        },
        {
          "type": "box",
          "style": { "alignItems": "center", "gap": 16, "position": "relative" },
          "children": [
            { "type": "image", "if": "logo", "src": "{{logo}}", "style": { "width": 56, "height": 56, "borderRadius": 14, "objectFit": "cover" } },
            {
              "type": "box",
              "if": "!logo",
              "style": { "width": 56, "height": 56, "borderRadius": 14, "backgroundColor": "{{accentColor}}", "alignItems": "center", "justifyContent": "center" },
              "children": [{ "type": "box", "style": { "width": 22, "height": 22, "borderRadius": 11, "backgroundColor": "#ffffff" } }]
            },
            { "type": "text", "text": "{{siteName}}", "style": { "fontSize": 30, "fontWeight": 700, "letterSpacing": -0.5 } }
          ]
        },
        {
          "type": "box",
          "style": { "flexDirection": "column", "gap": 22, "position": "relative", "maxWidth": 960 },
          "children": [
            { "type": "text", "text": "{{title}}", "style": { "fontSize": 68, "fontWeight": 800, "lineHeight": 1.08, "letterSpacing": -2, "whiteSpace": "pre-wrap" } },
            {
              "type": "text",
              "if": "description",
              "text": "{{description}}",
              "style": { "fontSize": 30, "lineHeight": 1.4, "opacity": 0.7, "whiteSpace": "pre-wrap" }
            }
          ]
        },
        {
          "type": "box",
          "style": { "alignItems": "center", "justifyContent": "space-between", "position": "relative" },
          "children": [
            {
              "type": "text",
              "if": "tag",
              "text": "{{tag}}",
              "style": { "fontSize": 24, "fontWeight": 700, "color": "#ffffff", "backgroundColor": "{{accentColor}}", "padding": "8px 22px", "borderRadius": 999 }
            },
            { "type": "box", "if": "!tag" },
            { "type": "text", "if": "url", "text": "{{url}}", "style": { "fontSize": 26, "fontWeight": 600, "opacity": 0.6 } }
          ]
        }
      ]
    }
  }
}
