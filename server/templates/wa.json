{
  "slug": "wa",
  "name": "WhatsApp Chat",
  "description": "A two-message WhatsApp conversation in dark mode.",
  "category": "chat",
  "definition": {
    "width": 420,
    "params": {
      "contactName": {
        "type": "string",
        "label": "Contact name",
        "default": "John",
        "maxLength": 40
      },
      "contactAvatar": {
        "type": "image",
        "label": "Contact avatar",
        "default": ""
      },
      "status": {
        "type": "string",
        "label": "Status",
        "default": "online",
        "maxLength": 40
      },
      "msg1": {
        "type": "string",
        "label": "Received message",
        "default": "Hey, how are you?",
        "maxLength": 400,
        "multiline": true
      },
      "time1": {
        "type": "string",
        "label": "Received time",
        "default": "10:30",
        "maxLength": 10
      },
      "msg2": {
        "type": "string",
        "label": "Sent message",
        "default": "I'm good! Thanks for asking 😊",
        "maxLength": 400,
        "multiline": true
      },
      "time2": {
        "type": "string",
        "label": "Sent time",
        "default": "10:31",
        "maxLength": 10
      }
    },
    "root": {
      "type": "box",
      "style": {
        "flexDirection": "column",
        "width": "100%",
        "fontFamily": "Inter",
        "backgroundColor": "#0b141a",
        "borderRadius": 12,
        "overflow": "hidden"
      },
      "children": [
        {
          "type": "box",
          "style": {
            "alignItems": "center",
            "padding": "10px 16px",
            "backgroundColor": "#1f2c34"
          },
          "children": [
            {
              "type": "image",
              "if": "contactAvatar",
              "src": "{{contactAvatar}}",
              "style": {
                "width": 40,
                "height": 40,
                "borderRadius": 20,
                "objectFit": "cover",
                "marginRight": 12
              }
            },
            {
              "type": "box",
              "if": "!contactAvatar",
              "style": {
                "width": 40,
                "height": 40,
                "borderRadius": 20,
                "backgroundColor": "#00a884",
                "marginRight": 12
              }
            },
            {
              "type": "box",
              "style": {
                "flexDirection": "column"
              },
              "children": [
                {
                  "type": "text",
                  "text": "{{contactName}}",
                  "style": {
                    "color": "#e9edef",
                    "fontSize": 16,
                    "fontWeight": 600
                  }
                },
                {
                  "type": "text",
                  "text": "{{status}}",
                  "style": {
                    "color": "#8696a0",
                    "fontSize": 13
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "box",
          "style": {
            "flexDirection": "column",
            "padding": 16,
            "minHeight": 180,
            "gap": 8
          },
          "children": [
            {
              "type": "box",
              "if": "msg1",
              "style": {
                "flexDirection": "column",
                "alignSelf": "flex-start",
                "maxWidth": "80%",
                "padding": "8px 12px",
                "borderRadius": 8,
                "borderTopLeftRadius": 0,
                "backgroundColor": "#1f2c34"
              },
              "children": [
                {
                  "type": "text",
                  "text": "{{msg1}}",
                  "style": {
                    "color": "#e9edef",
                    "fontSize": 15,
                    "lineHeight": 1.4,
                    "whiteSpace": "pre-wrap"
                  }
                },
                {
                  "type": "text",
                  "text": "{{time1}}",
                  "style": {
                    "color": "#8696a0",
                    "fontSize": 11,
                    "alignSelf": "flex-end",
                    "marginTop": 2
                  }
                }
              ]
            },
            {
              "type": "box",
              "if": "msg2",
              "style": {
                "flexDirection": "column",
                "alignSelf": "flex-end",
                "maxWidth": "80%",
                "padding": "8px 12px",
                "borderRadius": 8,
                "borderTopRightRadius": 0,
                "backgroundColor": "#005c4b"
              },
              "children": [
                {
                  "type": "text",
                  "text": "{{msg2}}",
                  "style": {
                    "color": "#e9edef",
                    "fontSize": 15,
                    "lineHeight": 1.4,
                    "whiteSpace": "pre-wrap"
                  }
                },
                {
                  "type": "box",
                  "style": {
                    "alignSelf": "flex-end",
                    "alignItems": "center",
                    "marginTop": 2
                  },
                  "children": [
                    {
                      "type": "text",
                      "text": "{{time2}}",
                      "style": {
                        "color": "#8696a0",
                        "fontSize": 11
                      }
                    },
                    {
                      "type": "box",
                      "style": {
                        "marginLeft": 6,
                        "gap": 1
                      },
                      "children": [
                        {
                          "type": "box",
                          "style": {
                            "width": 4,
                            "height": 8,
                            "borderRight": "1.5px solid #53bdeb",
                            "borderBottom": "1.5px solid #53bdeb",
                            "transform": "rotate(45deg)",
                            "marginTop": -3
                          }
                        },
                        {
                          "type": "box",
                          "style": {
                            "width": 4,
                            "height": 8,
                            "borderRight": "1.5px solid #53bdeb",
                            "borderBottom": "1.5px solid #53bdeb",
                            "transform": "rotate(45deg)",
                            "marginTop": -3
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
