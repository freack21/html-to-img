{
  "slug": "ig-story",
  "name": "Story",
  "description": "1080×1920 story for Instagram, WhatsApp or TikTok with photo, headline and call to action.",
  "category": "social",
  "definition": {
    "width": 1080,
    "height": 1920,
    "params": {
      "photo": { "type": "image", "label": "Background photo", "default": "" },
      "kicker": { "type": "string", "label": "Kicker", "default": "NEW DROP", "maxLength": 30 },
      "headline": { "type": "string", "label": "Headline", "default": "Weekend\nflash sale", "maxLength": 60, "multiline": true },
      "body": { "type": "string", "label": "Body", "default": "Up to 50% off everything. Only until Sunday midnight.", "maxLength": 160, "multiline": true },
      "cta": { "type": "string", "label": "Call to action", "default": "Link in bio", "maxLength": 30 },
      "handle": { "type": "string", "label": "Handle", "default": "@yourbrand", "maxLength": 30 },
      "fromColor": { "type": "color", "label": "Gradient start", "default": "#f97316" },
      "toColor": { "type": "color", "label": "Gradient end", "default": "#db2777" },
      "textColor": { "type": "color", "label": "Text color", "default": "#ffffff" }
    },
    "root": {
      "type": "box",
      "style": {
        "position": "relative",
        "flexDirection": "column",
        "justifyContent": "space-between",
        "width": "100%",
        "height": "100%",
        "padding": "120px 90px 160px",
        "fontFamily": "Poppins",
        "color": "{{textColor}}",
        "backgroundImage": "linear-gradient(160deg, {{fromColor}} 0%, {{toColor}} 100%)"
      },
      "children": [
        {
          "type": "image",
          "if": "photo",
          "src": "{{photo}}",
          "style": { "position": "absolute", "top": 0, "left": 0, "width": "100%", "height": "100%", "objectFit": "cover" }
        },
        {
          "type": "box",
          "if": "photo",
          "style": {
            "position": "absolute",
            "top": 0,
            "left": 0,
            "width": "100%",
            "height": "100%",
            "backgroundImage": "linear-gradient(180deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0) 30%, rgba(0,0,0,0.15) 50%, rgba(0,0,0,0.8) 100%)"
          }
        },
        {
          "type": "box",
          "if": "!photo",
          "style": { "position": "absolute", "top": 260, "right": -220, "width": 760, "height": 760, "borderRadius": 380, "backgroundColor": "rgba(255,255,255,0.12)" }
        },
        {
          "type": "box",
          "if": "!photo",
          "style": { "position": "absolute", "bottom": 380, "left": -260, "width": 620, "height": 620, "borderRadius": 310, "backgroundColor": "rgba(255,255,255,0.08)" }
        },
        {
          "type": "box",
          "style": { "position": "relative", "justifyContent": "space-between", "alignItems": "center" },
          "children": [
            {
              "type": "text",
              "if": "handle",
              "text": "{{handle}}",
              "style": { "fontSize": 38, "fontWeight": 600, "padding": "14px 34px", "borderRadius": 999, "backgroundColor": "rgba(0,0,0,0.25)" }
            }
          ]
        },
        {
          "type": "box",
          "style": { "position": "relative", "flexDirection": "column", "gap": 36 },
          "children": [
            { "type": "text", "if": "kicker", "text": "{{kicker}}", "style": { "fontSize": 40, "fontWeight": 700, "letterSpacing": 8, "opacity": 0.9 } },
            { "type": "text", "text": "{{headline}}", "style": { "fontFamily": "Anton", "fontSize": 190, "lineHeight": 1, "textTransform": "uppercase", "whiteSpace": "pre-wrap" } },
            { "type": "text", "if": "body", "text": "{{body}}", "style": { "fontSize": 46, "lineHeight": 1.4, "opacity": 0.92, "whiteSpace": "pre-wrap" } },
            {
              "type": "box",
              "if": "cta",
              "style": { "marginTop": 30 },
              "children": [
                {
                  "type": "text",
                  "text": "{{cta}}  ›",
                  "style": { "fontSize": 44, "fontWeight": 700, "color": "#111111", "backgroundColor": "#ffffff", "padding": "26px 56px", "borderRadius": 999 }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
