{
  "slug": "quote",
  "name": "Quote",
  "description": "Square quote card with gradient, solid or photo background.",
  "category": "social",
  "definition": {
    "width": 800,
    "height": 800,
    "params": {
      "quote": {
        "type": "string",
        "label": "Quote",
        "default": "The only way to do great work is to love what you do.",
        "maxLength": 300,
        "multiline": true
      },
      "author": {
        "type": "string",
        "label": "Author",
        "default": "Steve Jobs",
        "maxLength": 60
      },
      "bgImage": {
        "type": "image",
        "label": "Background photo",
        "default": ""
      },
      "bgColor": {
        "type": "color",
        "label": "Background color",
        "default": "#667eea"
      },
      "textColor": {
        "type": "color",
        "label": "Text color",
        "default": "#ffffff"
      },
      "theme": {
        "type": "enum",
        "label": "Background style",
        "options": [
          "gradient",
          "solid"
        ],
        "default": "gradient"
      }
    },
    "root": {
      "type": "box",
      "style": {
        "position": "relative",
        "width": "100%",
        "height": "100%",
        "backgroundColor": "{{bgColor}}",
        "fontFamily": "Playfair Display"
      },
      "children": [
        {
          "type": "box",
          "if": "theme == gradient",
          "style": {
            "position": "absolute",
            "top": 0,
            "left": 0,
            "width": "100%",
            "height": "100%",
            "backgroundImage": "linear-gradient(135deg, rgba(255,255,255,0.15) 0%, rgba(118,75,162,0.85) 100%)"
          }
        },
        {
          "type": "image",
          "if": "bgImage",
          "src": "{{bgImage}}",
          "style": {
            "position": "absolute",
            "top": 0,
            "left": 0,
            "width": "100%",
            "height": "100%",
            "objectFit": "cover"
          }
        },
        {
          "type": "box",
          "if": "bgImage",
          "style": {
            "position": "absolute",
            "top": 0,
            "left": 0,
            "width": "100%",
            "height": "100%",
            "backgroundColor": "rgba(0,0,0,0.5)"
          }
        },
        {
          "type": "box",
          "style": {
            "flexDirection": "column",
            "justifyContent": "center",
            "width": "100%",
            "height": "100%",
            "padding": 80,
            "color": "{{textColor}}",
            "position": "relative"
          },
          "children": [
            {
              "type": "text",
              "text": "“",
              "style": {
                "fontSize": 160,
                "lineHeight": 1,
                "height": 90,
                "opacity": 0.5
              }
            },
            {
              "type": "text",
              "text": "{{quote}}",
              "style": {
                "fontSize": 50,
                "fontStyle": "italic",
                "lineHeight": 1.3,
                "whiteSpace": "pre-wrap"
              }
            },
            {
              "type": "box",
              "if": "author",
              "style": {
                "width": 80,
                "height": 4,
                "borderRadius": 2,
                "backgroundColor": "{{textColor}}",
                "marginTop": 40,
                "marginBottom": 20,
                "opacity": 0.7
              }
            },
            {
              "type": "text",
              "if": "author",
              "text": "— {{author}}",
              "style": {
                "fontSize": 28,
                "fontFamily": "Inter",
                "fontWeight": 600,
                "letterSpacing": 1
              }
            }
          ]
        }
      ]
    }
  }
}
