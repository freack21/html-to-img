<%- include("./layout/header") %>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Caveat:wght@400;600&display=swap");
  @import url("https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700;800&display=swap");

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    border: none;
  }
  body {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px;
  }
  #wrapper {
    width: 1080px;
    aspect-ratio: 1 / 1;
    background-color: #fff;
    position: relative;
    background: url("<%- img %>");
    background-size: cover;
    background-position: center;
  }
  .content {
    width: 75%;
    height: 75%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    position: absolute;
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    background: transparent;
    display: flex;
    flex-direction: column;
    justify-content: start;
    gap: 0;
    font-family: "Figtree", sans-serif;
    overflow: hidden;
    border: none;
  }

  .avatar {
    width: 64px;
    border-radius: 50%;
    object-fit: cover;
  }
</style>

<div id="wrapper">
  <div class="content">
    <!-- Header -->
    <div
      style="
        background: #fff;
        padding: 16px 32px;
        display: flex;
        flex-direction: row;
        align-items: center;
        box-shadow: none;
      "
    >
      <img src="<%- avatar %>" alt="avatar" class="avatar" />
      <p
        style="
          margin-left: 16px;
          color: #333;
          font-weight: 600;
          font-size: 28px;
        "
      >
        @fkrvndii
      </p>
    </div>

    <!-- Middle content area -->
    <div
      style="
        flex-grow: 1;
        background: transparent;
        border-color: #fff;
        border-left: 32px solid #fff;
        border-right: 32px solid #fff;
        box-shadow: none;
      "
    ></div>

    <!-- Footer -->
    <div
      style="
        background: #fff;
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 32px;
        padding-top: 16px;
        font-size: 24px;
        border-color: #fff;
        box-shadow: none;
      "
    >
      <p>do you think i have forgotten?</p>
    </div>
  </div>
</div>

<%- include("./layout/footer") %>
