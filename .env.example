# Copy to .env and adjust. Every value is optional.

PORT=3003
# Bind to localhost and let Nginx face the internet.
HOST=127.0.0.1
NODE_ENV=production

# Public origin used in returned image URLs (no trailing slash).
# Defaults to the request's protocol + Host header.
PUBLIC_URL=https://img.example.com

# Express "trust proxy" value; "loopback" fits Nginx on the same machine.
TRUST_PROXY=loopback

# Where the SQLite database and rendered files live (relative to the repo root).
DATA_DIR=data
# DATABASE_PATH=data/app.db
# STORAGE_DIR=data/storage

# Remote images referenced by templates.
MAX_IMAGE_BYTES=5242880
IMAGE_TIMEOUT_MS=5000
# Never enable in production: allows fetching images from private networks.
ALLOW_PRIVATE_IMAGE_HOSTS=false

# Twemoji SVG base URL for emoji rendering. Set to an empty value to disable emoji.
# EMOJI_BASE_URL=https://cdn.jsdelivr.net/gh/jdecked/twemoji@15.1.0/assets/svg/

# Used once by `npm run create-admin`; remove it afterwards.
# ADMIN_PASSWORD=
